{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/button/**",
              "components/data-row/**",
              "components/disclaimer/**",
              "components/forms/**",
              "components/founder-note/**",
              "components/map-marker/**",
              "components/navbar/**",
              "components/property-card/**",
              "components/social/**",
              "components/status-pill/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inversionz|Inversionz Unboxed|Inter|JetBrains Mono|Space Grotesk|Noto Sans Telugu))/i]",
        "message": "Font not provided by the design system. Available: Inversionz, Inversionz Unboxed, Inter, JetBrains Mono, Space Grotesk, Noto Sans Telugu."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|mono|block|icon|iconRight|href|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, mono, block, icon, iconRight, href, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|tone|stack|last|style|key|ref|className|style|children)$/]",
        "message": "<DataRow> doesn't accept that prop. Declared props: label, value, tone, stack, last, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:signal|verified|risk|saffron)$/]",
        "message": "<DataRow> tone must be one of 'signal' | 'verified' | 'risk' | 'saffron'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclaimer'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|reraNumber|project|compact|children|style|key|ref|className|style|children)$/]",
        "message": "<Disclaimer> doesn't accept that prop. Declared props: variant, reraNumber, project, compact, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclaimer'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:owner|builder)$/]",
        "message": "<Disclaimer> variant must be one of 'owner' | 'builder'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FounderNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|quote|children|name|role|date|style|key|ref|className|style|children)$/]",
        "message": "<FounderNote> doesn't accept that prop. Declared props: label, quote, children, name, role, date, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsideListForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:onSubmit|title|intro|style|key|ref|className|style|children)$/]",
        "message": "<InsideListForm> doesn't accept that prop. Declared props: onSubmit, title, intro, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:live|label|pulse|style|key|ref|className|style|children)$/]",
        "message": "<MapMarker> doesn't accept that prop. Declared props: live, label, pulse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|filled|style|key|ref|className|style|children)$/]",
        "message": "<Monogram> doesn't accept that prop. Declared props: size, filled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|current|onNavigate|status|cta|onCta|wordmarkSize|style|key|ref|className|style|children)$/]",
        "message": "<Navbar> doesn't accept that prop. Declared props: links, current, onNavigate, status, cta, onCta, wordmarkSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostTemplate'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|headline|body|secondary|statuses|city|handle|media|scale|theme|key|ref|className|style|children)$/]",
        "message": "<PostTemplate> doesn't accept that prop. Declared props: kicker, headline, body, secondary, statuses, city, handle, media, scale, theme."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostTemplate'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<PostTemplate> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PropertyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:statuses|kicker|title|location|media|mediaLabel|data|price|priceNote|cta|ctaHref|onCta|variant|reraNumber|project|compactDisclaimer|style|key|ref|className|style|children)$/]",
        "message": "<PropertyCard> doesn't accept that prop. Declared props: statuses, kicker, title, location, media, mediaLabel, data, price, priceNote, cta, ctaHref, onCta, variant, reraNumber, project, compactDisclaimer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PropertyCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:owner|builder)$/]",
        "message": "<PropertyCard> variant must be one of 'owner' | 'builder'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReelEndCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:cta|line|city|handle|scale|overFootage|media|key|ref|className|style|children)$/]",
        "message": "<ReelEndCard> doesn't accept that prop. Declared props: cta, line, city, handle, scale, overFootage, media."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|value|tone|dot|tick|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: kind, label, value, tone, dot, tick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:live-drop|coming-soon|oc|rera|approved|dtcp|bank-loan|owner-listed|nri-ready|risk)$/]",
        "message": "<StatusPill> kind must be one of 'live-drop' | 'coming-soon' | 'oc' | 'rera' | 'approved' | 'dtcp' | 'bank-loan' | 'owner-listed' | 'nri-ready' | 'risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:live|verified|signal|risk|neutral)$/]",
        "message": "<StatusPill> tone must be one of 'live' | 'verified' | 'signal' | 'risk' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|prefix|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, error, prefix."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|lockup|city|tagline|status|inverse|plate|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, lockup, city, tagline, status, inverse, plate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='lockup'] > Literal[value!=/^(?:wordmark|tagline|city|status)$/]",
        "message": "<Wordmark> lockup must be one of 'wordmark' | 'tagline' | 'city' | 'status'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
