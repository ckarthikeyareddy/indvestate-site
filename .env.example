# INDVESTATE · environment. Copy to .env.local for development; set the same
# names in Vercel for Preview and Production. Without them /api/lead logs each
# lead to the server console in development and answers 503 in production, so
# the form shows "Could not send. WhatsApp the desk instead."

# Resend (https://resend.com). One email per form to the desk.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend. Defaults to desk@indvestate.com.
LEAD_FROM="INDVESTATE desk <desk@indvestate.com>"
# Where leads land. Defaults to desk@indvestate.com; the topic alias is cc'd.
LEAD_TO=desk@indvestate.com

# Vercel KV (Upstash Redis via the Vercel Marketplace). Vercel sets these when
# the store is linked to the project; copy them from the store's ".env.local" tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
